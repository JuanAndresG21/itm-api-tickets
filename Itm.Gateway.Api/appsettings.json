{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "SECRET_REPLACED_BY_ENV",
    "Issuer": "Itm.Booking.Api"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "AuthorizationPolicy": "jwt-policy",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        }
      },
      "event-route": {
        "ClusterId": "event-cluster",
        "AuthorizationPolicy": "jwt-policy",
        "Match": {
          "Path": "/api/events/{**catch-all}"
        }
      },
      "discount-route": {
        "ClusterId": "discount-cluster",
        "AuthorizationPolicy": "jwt-policy",
        "Match": {
          "Path": "/api/discounts/{**catch-all}"
        }
      },
      "signalr-route": {
        "ClusterId": "booking-cluster",
        "AuthorizationPolicy": "jwt-policy",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "booking-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5148/"
          }
        }
      },
      "event-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5161/"
          }
        }
      },
      "discount-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5176/"
          }
        }
      }
    }
  }
}

